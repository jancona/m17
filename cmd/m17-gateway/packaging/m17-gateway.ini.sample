[General]
; Example: N1ADJ or N1ADJ G
Callsign=CALLSIGN_PLACEHOLDER
DashboardLog=/opt/m17/m17-gateway/dashboard.log
AudioDir=audio/

[Radio]
; Hertz
RXFrequency=439000000
TXFrequency=439000000
; Power dbm
Power=10
AFC=true
FrequencyCorr=0
Duplex=false

[Reflector]
HostFile=/opt/m17/m17-gateway/M17Hosts.txt
OverrideHostFile=/opt/m17/m17-gateway/OverrideHosts.txt
Name=M17-M17
Module=C

[Log]
; Logging levels: ERROR, INFO, DEBUG
Level=DEBUG

[Modem]
; Change Type to mmdvm or sx1255 for MMDVM or SX1255 hardware
Type=cc1200
Port=/dev/ttyAMA0
; 460800 for cc1200. Typically 115200 or 460800 for MMDVM.
Speed=460800
; CC1200-specific
NRSTPin=21
Boot0Pin=20
ZMQPort=0
; MMDVM-specific
Protocol=uart
RXInvert=false
TXInvert=true
PTTInvert=false
Debug=false
TXDCOffset=0
TXDelay=100
RXLevel=50
RXDCOffset=0
TXLevel=50
TXHang=5
; SX1255-specific
SPIDevice = /dev/spidev0.0
GPIOChip = gpiochip0
ResetPin = 22
; In most cases the ALSA devices may be left blank
ALSACaptureDevice = 
ALSAPlaybackDevice = 
; RX LNA gain. The SX1255 supports only these six settings, in uneven steps:
; 0, 12, 24, 36, 42 or 48 dB. Anything else is snapped to the nearest and logged.
;
; This is a compromise, not a "more is better" setting, because there is no AGC.
; Too little and weak signals are lost in the receiver's own noise; too much and
; strong ones overload the front end. Both show up as a rising bit error rate,
; which m17-gateway logs at the end of every received stream.
;
; 24 dB suits a typical hotspot: a handheld at 1 W a few metres away has been
; measured to overload at 36 dB and above, while a weaker or more distant signal
; needs more than 0 dB to be heard at all. Tune by watching the BER figures.
LNAGain = 24
; RX PGA gain (0-30 dB in 2 dB steps).
PGAGain = 0
; TX DAC gain (0, -3, -6, or -9 dB), where 0 is full scale.
; NOTE: releases before this one had this setting inverted, so a configured 0
; produced -9 dB and -9 produced 0 dB. If you tuned DACGain against an older
; build, negate it to keep the same transmit level.
DACGain = -3
; TX mixer gain (-37.5 to -7.5 dB in 2 dB steps)
MixerGain = -12
; Diagnostics: dump raw received IQ to a file for off-line analysis, then stop.
; ALSA hw devices are exclusive, so arecord cannot read the SX1255 while the
; gateway is running -- this is the way to capture what the gateway itself sees.
; The format is raw interleaved stereo S32_LE at 125000 Sa/s (left=I, right=Q).
; Leave blank to disable. Writes ~1 MB/s, so mind the card space.
RawIQCapture =
RawIQSeconds = 20