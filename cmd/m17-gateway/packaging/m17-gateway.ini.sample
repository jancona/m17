[General]
# Example: N1ADJ or N1ADJ G
Callsign=CALLSIGN_PLACEHOLDER
DashboardLog=/opt/m17/m17-gateway/dashboard.log
AudioDir=audio/

[Radio]
# Hertz
RXFrequency=439000000
TXFrequency=439000000
# Power dbm
Power=10
AFC=true
FrequencyCorr=0
Duplex=false

[Reflector]
HostFile=/opt/m17/m17-gateway/M17Hosts.txt
OverrideHostFile=/opt/m17/m17-gateway/OverrideHosts.txt
Name=M17-M17
Module=C

[Log]
# Logging levels: ERROR, INFO, DEBUG
Level=DEBUG

[Modem]
# Change Type to mmdvm for MMDVM modems/hotspots
Type=cc1200v2
Port=/dev/ttyAMA0
# 460800 for cc1200. Typically 115200 or 460800 for MMDVM.
Speed=460800
# CC1200-specific
NRSTPin=21
Boot0Pin=20
ZMQPort=0
# MMDVM-specific
Protocol=uart
RXInvert=false
TXInvert=true
PTTInvert=false
Debug=false
TXDCOffset=0
TXDelay=100
RXLevel=50
RXDCOffset=0
TXLevel=50
TXHang=5
